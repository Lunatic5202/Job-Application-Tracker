# ==========================================
# CareerX Backend Environment Variables
# ==========================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
APP_NAME=CareerX Backend API
API_PREFIX=/api

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=careerx_db

# Security & JWT Authentication
# In production, must be at least 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=careerx-development-jwt-secret-key-32-chars-min-deterministic
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS & Frontend Origins (Comma-separated for multiple origins)
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# File Storage Configuration (Avatars, Resumes)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=10485760
STORAGE_BACKEND=local

# AI & Groq LLM Configuration (Backend Only - NEVER expose to frontend)
# If omitted or invalid, AI endpoints return explicit HTTP 503 instead of mock answers
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
